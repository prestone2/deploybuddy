{
  "compilerOptions": {
    "target": "ES2022", "module": "Node16", "moduleResolution": "Node16",
    "rootDir": "src", "outDir": "lib", "strict": true,
    "noUncheckedIndexedAccess": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "types": ["node"], "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
