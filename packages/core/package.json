{
  "name": "@deploybuddy/core",
  "version": "0.1.0",
  "description": "Platform-independent deterministic deployment intelligence for DeployBuddy.",
  "license": "MIT",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "engines": { "node": ">=20" },
  "files": ["dist", "README.md", "LICENSE"],
  "repository": { "type": "git", "url": "https://github.com/prestone2/deploybuddy.git", "directory": "packages/core" },
  "homepage": "https://github.com/prestone2/deploybuddy#readme",
  "bugs": { "url": "https://github.com/prestone2/deploybuddy/issues" },
  "keywords": ["deployment", "devops", "risk", "release-readiness", "policy"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.cjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  }
}
