{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deploybuddy:schema:1",
  "title": "DeployBuddy repository configuration",
  "description": "Declarative deployment policy and release gates. This schema accepts data only; it cannot execute commands or load remote configuration.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "safeMax": { "type": "integer", "minimum": 0, "maximum": 98 },
        "cautionMax": { "type": "integer", "minimum": 1, "maximum": 99 }
      }
    },
    "exitOnDanger": { "type": "boolean" },
    "risk": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "maxScore": { "type": "integer", "minimum": 0, "maximum": 100 },
        "failOnQuestionable": { "type": "boolean" }
      }
    },
    "confidence": {
      "type": "object", "additionalProperties": false,
      "properties": { "minimumScore": { "type": "integer", "minimum": 0, "maximum": 100 } }
    },
    "git": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "requireClean": { "type": "boolean" },
        "requireUpToDate": { "type": "boolean" },
        "allowDetachedHead": { "type": "boolean" },
        "allowUntracked": { "type": "boolean" }
      }
    },
    "diagnostics": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "maxErrors": { "type": "integer", "minimum": 0 },
        "maxWarnings": { "type": "integer", "minimum": 0 }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "requireTests": { "type": "boolean" },
        "requireBuild": { "type": "boolean" },
        "requireLint": { "type": "boolean" }
      }
    },
    "frameworks": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "allowed": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/framework" } },
        "required": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/framework" } }
      }
    },
    "release": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "requiredReadiness": { "enum": ["ready", "needs_attention", "insufficient_evidence", "blocked"] },
        "maxRisk": { "type": "integer", "minimum": 0, "maximum": 100 },
        "minimumConfidence": { "type": "integer", "minimum": 0, "maximum": 100 },
        "allowedChangeAttention": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["low", "moderate", "high", "critical"] }
        },
        "requirePolicyPass": { "type": "boolean" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          { "required": ["risk"] },
          { "required": ["confidence"] },
          { "required": ["git"] },
          { "required": ["diagnostics"] },
          { "required": ["evidence"] },
          { "required": ["frameworks"] },
          { "required": ["release"] }
        ]
      },
      "then": { "required": ["version"] }
    }
  ],
  "$defs": {
    "framework": { "enum": ["laravel", "vite", "react", "vue", "next.js", "nuxt", "svelte", "angular", "express", "nestjs", "astro"] }
  }
}
