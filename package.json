{
  "name": "should-i-deploy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "core:build": "npm --prefix packages/core run build",
    "node-adapter:build": "npm --prefix packages/core run build && npm --prefix packages/node-adapter run build",
    "action:build": "npm --prefix apps/github-action run build",
    "action:test": "npm --prefix apps/github-action test",
    "vscode:build": "npm --prefix deploybuddy-extension run compile",
    "cli:build": "npm --prefix apps/cli run build",
    "vscode:test": "npm --prefix deploybuddy-extension test",
    "cli:test": "npm --prefix apps/cli test",
    "validate:platform": "node scripts/validate-platform.cjs",
    "pack:all": "node scripts/pack-artifacts.cjs",
    "release:check": "node scripts/release-check.cjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
